Options -MultiViews

RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.crawlspaceencapsulationcharlottenc\.com$ [NC]
RewriteRule ^(.*)$ https://crawlspaceencapsulationcharlottenc.com/$1 [R=301,L]

RewriteRule ^services/crawl-space-inspection(?:\.html)?$ /blog/what-happens-during-a-crawl-space-inspection [R=301,L]
RewriteRule ^services/vapor-barrier-installation(?:\.html)?$ /blog/do-i-need-a-vapor-barrier-in-my-crawl-space [R=301,L]
RewriteRule ^services/crawl-space-moisture-control(?:\.html)?$ /blog/how-do-you-control-moisture-in-a-crawl-space [R=301,L]
RewriteRule ^services/crawl-space-waterproofing-drainage(?:\.html)?$ /blog/how-do-you-waterproof-a-crawl-space-with-drainage [R=301,L]
RewriteRule ^services/crawl-space-dehumidifiers(?:\.html)?$ /blog/does-my-crawl-space-need-a-dehumidifier [R=301,L]
RewriteRule ^services/crawl-space-insulation(?:\.html)?$ /blog/should-crawl-space-insulation-be-replaced-after-encapsulation [R=301,L]
RewriteRule ^problems/wet-crawl-space(?:\.html)?$ /blog/why-is-my-crawl-space-wet [R=301,L]
RewriteRule ^problems/mold-smell(?:\.html)?$ /blog/why-does-my-crawl-space-smell-musty [R=301,L]
RewriteRule ^problems/standing-water(?:\.html)?$ /blog/what-causes-standing-water-in-a-crawl-space [R=301,L]
RewriteRule ^problems/sagging-floors(?:\.html)?$ /blog/can-crawl-space-moisture-cause-sagging-floors [R=301,L]
RewriteRule ^problems/high-humidity(?:\.html)?$ /blog/why-is-my-crawl-space-so-humid [R=301,L]
RewriteRule ^problems/wood-rot(?:\.html)?$ /blog/can-crawl-space-moisture-cause-wood-rot [R=301,L]
RewriteRule ^guides/crawlspace-encapsulation-cost-charlotte(?:\.html)?$ /blog/how-much-does-crawl-space-encapsulation-cost-in-charlotte [R=301,L]
RewriteRule ^guides/encapsulation-vs-vapor-barrier(?:\.html)?$ /blog/what-is-the-difference-between-encapsulation-and-a-vapor-barrier [R=301,L]
RewriteRule ^guides/diy-vs-professional-crawlspace-encapsulation(?:\.html)?$ /blog/should-i-encapsulate-my-crawl-space-myself [R=301,L]
RewriteRule ^guides/is-crawlspace-encapsulation-worth-it(?:\.html)?$ /blog/is-crawl-space-encapsulation-worth-it [R=301,L]
RewriteRule ^local/charlotte-clay-soil-crawlspace-moisture(?:\.html)?$ /blog/why-do-charlotte-crawl-spaces-have-moisture-problems [R=301,L]
RewriteRule ^local/charlotte-crawlspace-project-planning-example(?:\.html)?$ /blog/what-does-a-crawl-space-encapsulation-plan-include [R=301,L]
RewriteRule ^local/gaston-mecklenburg-crawlspace-service-area(?:\.html)?$ /blog/where-does-catawba-crawlspace-co-service-near-charlotte [R=301,L]
RewriteRule ^(?:services|problems|guides|local)(?:/index\.html|/)?$ /blog/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$ [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
